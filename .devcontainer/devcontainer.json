{
    "name": "seekdb v1.4.0",
    "image": "seekdb-build:v1.4.0",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/seekdb,type=bind",
    "workspaceFolder": "/workspace/seekdb",
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt=seccomp=unconfined"
    ],
    "mounts": [
        "source=seekdb-v1-4-0-deps,target=/workspace/seekdb/deps/3rd,type=volume"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "cschleiden.vscode-github-actions",
                "vadimcn.vscode-lldb"
            ],
            "settings": {
                "editor.formatOnSave": true
            }
        }
    }
}
